# ==============================================
# RECEPT.AI — Environment Variables
# ==============================================
# Copy this file to .env in both /backend and /frontend
# and fill in your actual values.

# ── SUPABASE ──────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── GROQ (AI Brain) ───────────────────────────
GROQ_API_KEY=gsk_your-groq-api-key

# ── VAPI (Voice Calls) ────────────────────────
VAPI_API_KEY=your-vapi-api-key
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret

# ── TWILIO (Telephony + WhatsApp) ─────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ── ELEVENLABS (Natural Voices) ───────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ── STRIPE (Payments) ─────────────────────────
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_BASIC=price_your-basic-price-id
STRIPE_PRICE_PRO=price_your-pro-price-id
STRIPE_PRICE_CLINIC=price_your-clinic-price-id

# ── RESEND (Transactional Emails) ─────────────
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@recept.ai

# ── AUTH ──────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ── APP CONFIG ────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
ADMIN_EMAIL=admin@recept.ai
NODE_ENV=development

# ── FRONTEND (Next.js — prefix with NEXT_PUBLIC_) ──
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
